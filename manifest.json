{
  "type": "plugin",
  "id": "com.zwjdujin.edgeever-rili",
  "name": "EdgeEver 日历",
  "version": "1.0.1",
  "apiVersion": "2",
  "settingsUi": "host",
  "description": "为 EdgeEver 添加日历功能：支持公历农历、快捷键插入日期时间、日历视图和笔记热力图。",
  "author": "zwjdujin",
  "entry": "./main.js",
  "platforms": [
    "web",
    "desktop"
  ],
  "permissions": [
    "notes:read",
    "notes:write",
    "editor:read",
    "editor:write",
    "ui:commands",
    "ui:notices",
    "ui:panels",
    "ui:navigation"
  ],
  "settings": {
    "fields": [
      {
        "key": "calendar-tag",
        "type": "text",
        "label": "日历标签",
        "default": "日历",
        "description": "带有此标签的笔记会在日历中显示。"
      },
      {
        "key": "date-format",
        "type": "text",
        "label": "日期格式",
        "default": "YYYY-MM-DD",
        "description": "插入日期的格式，支持 YYYY-MM-DD、MM/DD/DD、DD MM YYYY 等格式。"
      },
      {
        "key": "time-format",
        "type": "text",
        "label": "时间格式",
        "default": "YYYY-MM-DD HH:mm",
        "description": "插入时间的格式，包含日期和时间。"
      }
    ]
  }
}
